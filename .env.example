# Public origin; used for OAuth redirects and Origin checks.
BASE_URL=http://localhost:5173
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# openssl rand -base64 32
SESSION_SECRET=
# Becomes the first admin when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required: encrypts saved Google Calendar, Todoist, and Plaid sign-ins. openssl rand -base64 32.
# Keep a copy somewhere other than this server, such as a password manager.
TOKEN_ENCRYPTION_KEY=
# Optional: Todoist. Set both or neither.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Optional: Plaid, to link credit cards in Spend. Set both or neither.
# Each Plaid environment has its own secret: PLAID_SECRET must be the one for PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
LOG_LEVEL=info
